# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings → API). Never commit the real values.
#
# Only the publishable key belongs here — the secret key (SUPABASE_SECRET_KEY,
# Supabase's newer name for the service role key) must never be exposed to the
# frontend and is not used anywhere in this app.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
