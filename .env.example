# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings → API). Never commit the real values.
#
# Only the anon/public key belongs here — the service role key must never
# be exposed to the frontend and is not used anywhere in this app.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
